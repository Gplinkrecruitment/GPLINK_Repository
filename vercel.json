{
  "version": 2,
  "crons": [
    { "path": "/api/cron/process-gmail", "schedule": "0 * * * *" },
    { "path": "/api/cron/renew-gmail-watch", "schedule": "0 6 * * *" },
    { "path": "/api/cron/reconcile-followups", "schedule": "0 20 * * *" },
    { "path": "/api/cron/reconcile-doc-tasks", "schedule": "30 * * * *" },
    { "path": "/api/cron/interview-reminders", "schedule": "0 * * * *" },
    { "path": "/api/cron/weekly-sweep", "schedule": "0 22 * * *" },
    { "path": "/api/cron/weekly-backup", "schedule": "0 3 * * 0" },
    { "path": "/api/cron/call-summary-retry", "schedule": "0 0 * * *" },
    { "path": "/api/cron/call-reminders", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/detect-no-shows", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/purge-accounts", "schedule": "0 4 * * *" },
    { "path": "/api/cron/purge-identity-docs", "schedule": "0 4 * * *" },
    { "path": "/api/cron/check-model-updates", "schedule": "0 5 * * 1" },
    { "path": "/api/cron/recompute-intent", "schedule": "0 2 * * *" },
    { "path": "/api/cron/organize-drive", "schedule": "0 3 * * *" },
    { "path": "/api/cron/onboarding-nudge", "schedule": "0 * * * *" },
    { "path": "/api/cron/consult-nudge", "schedule": "20 * * * *" },
    { "path": "/api/cron/match-lifecycle", "schedule": "0 * * * *" },
    { "path": "/api/cron/sla-sweep", "schedule": "30 20 * * *" },
    { "path": "/api/cron/chase-nonresponders", "schedule": "0 21 * * *" },
    { "path": "/api/cron/practice-decision-reminders", "schedule": "50 21 * * *" },
    { "path": "/api/cron/owner-digest", "schedule": "0 21 * * 0" },
    { "path": "/api/cron/error-digest", "schedule": "40 21 * * *" },
    { "path": "/api/cron/error-fix-analysis", "schedule": "10 21 * * *" },
    { "path": "/api/cron/error-fix-execute", "schedule": "25 * * * *" },
    { "path": "/api/cron/refresh-summaries", "schedule": "*/30 * * * *" }
  ],
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "pages/**",
          "js/**",
          "css/**",
          "media/**",
          "documents/**",
          "assets/**",
          "sw.js",
          "manifest.webmanifest",
          "supabase/migrations/**",
          "data/.gitkeep"
        ],
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
